Configs: {
	WetnessConfig: {
		FireSpawnDust: {
			Tooltip: Показывать ли частицы дыма/пара при тушении
			Label: Fire Spawn Dust
		}

		FireDropTorchItem: {
			Tooltip: Возвращать ли предмет факела при его разрушении дождём (у костра предмет не выпадает - он просто гаснет, как от рычага)
			Label: Fire Drop Torch Item
		}

		FireBaseExtinguishChance: {
			Tooltip: Базовый шанс потушить факел/костёр за одну удачную проверку под дождём
			Label: Fire Base Extinguish Chance
		}

		FireMaxAttemptsPerTick: {
			Tooltip: Сколько случайных тайлов-кандидатов проверяется за один тик на игрока (как в TileWetnessSystem)
			Label: Fire Max Attempts Per Tick
		}

		FireMaxSkyCheckHeight: {
			Tooltip: Максимальная высота проверки открытого неба вверх от очага огня (ограничивает нагрузку на глубоких картах)
			Label: Fire Max Sky Check Height
		}

		FireExtinguishRangeX: {
			Tooltip: Радиус в блоках вокруг игрока, в котором отслеживаются факелы/костры для тушения
			Label: Fire Extinguish Range X
		}

		FireExtinguishEnabled: {
			Tooltip: Включает тушение факелов/костров дождём
			Label: Fire Extinguish Enabled
		}

		TileNeighborSpreadBonus: {
			Tooltip: Бонус к скорости намокания, если соседний блок на той же глубине уже стал грязью (для эффекта расползающегося пятна)
			Label: Tile Neighbor Spread Bonus
		}

		TileDepthRateMultiplier: {
			Tooltip: Во сколько раз медленнее мокнет каждый следующий слой земли вглубь (макс. глубина - 3 блока)
			Label: Tile Depth Rate Multiplier
		}

		TileSeepThreshold: {
			Tooltip: Насколько должен промокнуть верхний слой земли, прежде чем начнёт мокнуть слой под ним
			Label: Tile Seep Threshold
		}

		TileMaxAttemptsPerTick: {
			Tooltip: Сколько случайных блоков за тик пытается промокнуть/просохнуть система (меньше = медленнее и естественнее)
			Label: Tile Max Attempts Per Tick
		}

		TileDryRate: {
			Tooltip: Скорость высыхания грязи, когда дождь прекратился (% в тик)
			Label: Tile Dry Rate
		}

		TileWetRate: {
			Tooltip: Скорость накопления влаги в блоке земли под дождём за одну попытку (% за попытку)
			Label: Tile Wet Rate
		}

		TileWetnessRangeX: {
			Tooltip: Радиус в блоках влево/вправо от игрока, в котором отслеживается намокание земли
			Label: Tile Wetness Range X
		}

		Headers: {
			FireExtinguish: Fire Extinguish Header
			SoilToMud: Soil To Mud Header
			EquipmentEffects: Equipment Effects Header
			Drying: Drying Header
			Wetting: Wetting Header
		}

		AccessoryDisableThreshold: {
			Tooltip: Порог влажности, при котором аксессуар отключается
			Label: Accessory Disable Threshold
		}

		MaxArmorDefenseLossFraction: {
			Tooltip: Максимальная доля защиты, которую теряет полностью мокрая броня
			Label: Max Armor Defense Loss Fraction
		}

		UnderworldDryMultiplier: {
			Tooltip: ""
			Label: Underworld Dry Multiplier
		}

		CampfireDryMultiplier: {
			Tooltip: ""
			Label: Campfire Dry Multiplier
		}

		UndergroundDryMultiplier: {
			Tooltip: ""
			Label: Underground Dry Multiplier
		}

		CloudyOrNightDryMultiplier: {
			Tooltip: ""
			Label: Cloudy Or Night Dry Multiplier
		}

		SunnyDryMultiplier: {
			Tooltip: ""
			Label: Sunny Dry Multiplier
		}

		BaseDryRate: {
			Tooltip: Базовая скорость высыхания (% в тик), дальше умножается на модификаторы погоды/места
			Label: Base Dry Rate
		}

		JungleAmbientWetCap: {
			Tooltip: Максимальная влажность от одних только джунглей без дождя
			Label: Jungle Ambient Wet Cap
		}

		JungleAmbientWetRate: {
			Tooltip: Скорость фонового намокания в джунглях без дождя (% в тик)
			Label: Jungle Ambient Wet Rate
		}

		WaterWetRate: {
			Tooltip: Скорость намокания при погружении в воду (% в тик)
			Label: Water Wet Rate
		}

		RainWetRate: {
			Tooltip: Скорость намокания под дождём (% в тик)
			Label: Rain Wet Rate
		}

		DisplayName: Wetness Config
	}
}
